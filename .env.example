# Dribbble profile to track (used by the server and `npm run scrape`)
PROFILE_URL=https://dribbble.com/helistudio
MAX_SHOTS=200

# Server port (hosting platforms may inject their own PORT)
PORT=3000

# Optional in-process daily cron (NOT needed if you use the GitHub Actions
# workflow at .github/workflows/daily-scrape.yml — that is the recommended way)
ENABLE_CRON=false
CRON_SCHEDULE=50 23 * * *
# CRON_TZ=Asia/Tehran

# Timezone used to stamp each history row's calendar date. Set this to the team's
# timezone so a run just before midnight lands on the day it belongs to.
# HISTORY_TZ=Asia/Tehran

# --- Static (GitHub Pages) build only ---------------------------------------
# Set by the workflows, not usually needed locally.
# VITE_STATIC_DATA=true          # read data/*.json instead of the API
# VITE_GITHUB_REPO=owner/repo    # enables manual sync + saving registries
